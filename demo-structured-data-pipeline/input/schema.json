{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "department": {
      "type": "string"
    }
  },
  "required": [
    "employee_id",
    "name",
    "email",
    "department"
  ]
}